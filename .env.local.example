# ============================================================
# Supabase (já existentes — confira se estão no seu .env.local)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xbfegzlwptvdwibowkqav.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# ============================================================
# SMTP da Hostinger — usado pelas NOTIFICAÇÕES PRÓPRIAS do app
# (formulário de contato, avisos). NÃO é usado pelos emails de
# cadastro/recuperação de senha — esses são enviados pelo Supabase
# e devem ser configurados no painel do Supabase (Custom SMTP).
# ============================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@fightlog.com.br
SMTP_PASS=SENHA_DA_CAIXA_DE_EMAIL
SMTP_FROM=FightLog <contato@fightlog.com.br>

# (opcional) Para onde vão as mensagens do formulário de contato.
# Se não definir, usa o SMTP_USER (contato@fightlog.com.br).
EMAIL_TO=contato@fightlog.com.br
